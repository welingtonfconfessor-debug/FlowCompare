{
  "name": "flowcompare",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "php -S 127.0.0.1:8000 -t public",
    "test": "vite build && php tests/php-entry.test.php && node --test tests/rendered-html.test.mjs",
    "test:php": "php tests/php-entry.test.php",
    "test:geometry": "tsx --test tests/geometry-comparison.test.ts",
    "test:alignment": "tsx --test tests/alignment.test.ts",
    "test:canvas-tools": "tsx --test tests/canvas-tools.test.ts",
    "test:report": "tsx --test tests/report-generation.test.ts",
    "lint": "eslint . --ignore-pattern public/build"
  },
  "dependencies": {
    "dxf-parser": "^1.1.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.28.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tsx": "4.23.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
